# Copia este archivo a .env y llena los valores. Ninguno es obligatorio para correr el sitio en local:
# sin ellos el formulario sigue funcionando y registra el lead en la consola del servidor.

# Resend (https://resend.com) — envío del lead por correo. Requiere verificar el dominio vexonmexico.com.mx.
RESEND_API_KEY=
LEADS_TO_EMAIL=a.martinez@vexonmexico.com.mx
LEADS_FROM_EMAIL="Vexon Web <web@vexonmexico.com.mx>"

# Webhook opcional (Google Apps Script, Make, Zapier, CRM) que recibe el lead en JSON.
LEADS_WEBHOOK_URL=

# Cloudflare Turnstile (antispam invisible). Si se dejan vacíos, solo se usa el honeypot.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Analytics 4 (se carga después de la primera interacción para no afectar PageSpeed).
PUBLIC_GA_ID=

# Microsoft Clarity (opcional, carga diferida).
PUBLIC_CLARITY_ID=
