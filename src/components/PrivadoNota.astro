---
import Icon from './Icon.astro';
import { PRIVADO_NOTA } from '../lib/site';
interface Props { class?: string; tone?: 'light' | 'dark'; open?: boolean }
const { class: cls, tone = 'light', open = true } = Astro.props;
---
<details open={open} class:list={['rounded-xl p-4 text-[0.95rem] ring-1', tone === 'dark' ? 'text-white/75 ring-white/15' : 'text-vx-slate ring-vx-line', cls]}>
  <summary class="flex cursor-pointer items-center gap-2 font-display focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-vx-orange">
    <Icon name="lock" class="h-5 w-5 flex-none" />{PRIVADO_NOTA.titulo}
  </summary>
  <p class="mt-2">{PRIVADO_NOTA.texto}</p>
</details>
