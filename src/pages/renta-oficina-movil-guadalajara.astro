---
import { Picture } from 'astro:assets';
import foto from '../assets/fotos/oficina-movil-obra-portada.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import PrivadoNota from '../components/PrivadoNota.astro';
import WaButton from '../components/WaButton.astro';
import ModelCard from '../components/ModelCard.astro';
import Steps from '../components/Steps.astro';
import FaqList from '../components/FaqList.astro';
import { FAQ_RENTA } from '../data/faqs';
import { getModelo } from '../data/modelos';
import { SITE } from '../lib/site';
import { telLink } from '../lib/whatsapp';
import { breadcrumbs, faqPage, rentalService } from '../lib/schema';

const url = `${SITE.url}/renta-oficina-movil-guadalajara`;
const schema = [
  rentalService(url),
  breadcrumbs([{ name: 'Inicio', url: SITE.url }, { name: 'Renta de oficina móvil en Guadalajara', url }]),
  faqPage(FAQ_RENTA),
];
const modelos = [
  { m: getModelo('vx-4m')!, por: 'Para 5 personas' },
  { m: getModelo('vx-6m')!, por: 'Para 7 personas' },
  { m: getModelo('vx-8p')!, por: 'Para 6 personas con privado' },
];
---
<BaseLayout title="Renta de oficina móvil en Guadalajara | Vexon" description="Renta oficinas móviles equipadas para obra, remodelación o planta en Guadalajara y la ZMG. Elige modelo, cotiza por WhatsApp y trabaja desde el primer día." schema={schema} ogImage="/og/oficinas-moviles.jpg">
  <section class="relative isolate overflow-hidden bg-vx-sand pb-14 pt-4 sm:pt-6">
    <div class="pointer-events-none absolute inset-y-0 right-0 -z-10 hidden w-2/5 lg:block" aria-hidden="true"><Picture src={foto} formats={['avif']} fallbackFormat="webp" widths={[720, 1100]} sizes="40vw" alt="" class="photo-fade opacity-[.12]" loading="lazy" decoding="async" /></div>
    <div class="bg-grid pointer-events-none -z-10" aria-hidden="true"></div>
    <div class="bg-glow pointer-events-none -z-10 right-0 top-0 h-[28rem] w-[28rem]" aria-hidden="true"></div>
    <div class="hatch absolute -right-20 top-0 h-full w-1/3 opacity-40" aria-hidden="true"></div>
    <div class="wrap relative">
      <Breadcrumbs items={[{ name: 'Inicio', href: '/' }, { name: 'Renta de oficina móvil en Guadalajara' }]} />
      <div class="mt-6">
        <p class="eyebrow mb-3">RENTA</p>
        <h1 class="max-w-4xl text-[2.3rem] lg:max-w-[58%] leading-[1.05] sm:text-6xl">Renta de oficina móvil en Guadalajara</h1>
      </div>
      <p class="lead mt-5 !max-w-3xl lg:!max-w-[58%]">Rentamos oficinas móviles equipadas para obra, remodelación y planta en Guadalajara y su zona metropolitana. Eliges el modelo según cuántas personas trabajan, te cotizamos por WhatsApp, la llevamos y la nivelamos en tu predio, y al terminar tu renta la recogemos.</p>
      <div class="mt-7 flex flex-wrap items-center gap-3">
        <WaButton block="renta-hero" size="lg" />
        <a href={telLink} class="btn btn-ghost btn-lg" data-call data-block="renta-hero"><Icon name="phone" class="btn-icon" /> Llamar</a>
      </div>
      <p class="microcopy mt-3">Sin compromiso. Te respondemos por WhatsApp en horario de atención.</p>
    </div>
  </section>

  <section class="relative isolate overflow-hidden section bg-vx-paper" aria-labelledby="incluye-title">
    <div class="bg-grid pointer-events-none -z-10" aria-hidden="true"></div>
    <div class="bg-glow pointer-events-none -z-10 right-0 top-0 h-[28rem] w-[28rem]" aria-hidden="true"></div>
    <div class="wrap">
      <h2 id="incluye-title" class="text-4xl sm:text-5xl">Qué incluye la renta</h2>
      <ul class="mt-10 grid gap-3">
        {['Mesas de trabajo', 'Aire acondicionado', 'Ventanas e iluminación LED', 'Contactos de 127 V', 'Escalera y torres de nivelación', 'Traslado, instalación y recolección: se detallan en cada cotización'].map((item) => (
          <li class="flex gap-3 rounded-xl bg-vx-sand p-4"><Icon name="check" class="h-6 w-6 flex-none text-vx-orange" /><span>{item}</span></li>
        ))}
      </ul>
      <p class="mt-6">Las oficinas VX son de trabajo: no tienen sanitario ni cocineta.</p>
    </div>
  </section>

  <section class="relative isolate overflow-hidden section bg-vx-sand" aria-labelledby="mod-title">
    <div class="bg-grid pointer-events-none -z-10" aria-hidden="true"></div>
    <div class="bg-glow pointer-events-none -z-10 right-0 top-0 h-[28rem] w-[28rem]" aria-hidden="true"></div>
    <div class="wrap">
      <h2 id="mod-title" class="text-4xl sm:text-5xl">Elige el modelo para tu equipo</h2>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {modelos.map(({ m, por }) => (
          <div class="flex flex-col gap-3">
            <p class="font-display text-lg text-vx-black">{por}</p>
            <ModelCard m={m} block="renta-modelos" class="flex-1" />
          </div>
        ))}
      </div>
      <PrivadoNota class="mt-6" />
      <a href="/oficinas-moviles" class="mt-8 inline-block font-display text-vx-black underline decoration-vx-orange decoration-2 underline-offset-4">Ver los 8 modelos</a>
    </div>
  </section>

  <section class="relative isolate overflow-hidden section bg-vx-paper" aria-labelledby="pasos-title">
    <div class="bg-grid pointer-events-none -z-10" aria-hidden="true"></div>
    <div class="bg-glow pointer-events-none -z-10 right-0 top-0 h-[28rem] w-[28rem]" aria-hidden="true"></div>
    <div class="wrap">
      <h2 id="pasos-title" class="text-4xl sm:text-5xl">Cómo funciona la renta</h2>
      <div class="mt-10"><Steps /></div>
    </div>
  </section>

  <section class="relative isolate overflow-hidden section bg-vx-sand" aria-labelledby="zonas-title">
    <div class="bg-grid pointer-events-none -z-10" aria-hidden="true"></div>
    <div class="bg-glow pointer-events-none -z-10 right-0 top-0 h-[28rem] w-[28rem]" aria-hidden="true"></div>
    <div class="wrap">
      <h2 id="zonas-title" class="text-4xl sm:text-5xl">Zonas que atendemos</h2>
      <ul class="mt-10 flex flex-wrap gap-2">{SITE.areaServed.map((zona) => <li class="rounded-full bg-white px-4 py-2 font-display">{zona}</li>)}</ul>
      <p class="mt-6">Si tu obra está en otro punto de Jalisco, escríbenos y lo revisamos.</p>
    </div>
  </section>

  <section class="relative isolate overflow-hidden section bg-vx-paper" aria-labelledby="antes-title">
    <div class="bg-grid pointer-events-none -z-10" aria-hidden="true"></div>
    <div class="bg-glow pointer-events-none -z-10 right-0 top-0 h-[28rem] w-[28rem]" aria-hidden="true"></div>
    <div class="wrap">
      <h2 id="antes-title" class="text-4xl sm:text-5xl">Antes de rentar</h2>
      <ul class="mt-10 grid gap-3">
        <li><a href="/blog/como-cotizar-oficina-movil-para-obra-guadalajara" class="font-display text-vx-black underline decoration-vx-orange decoration-2 underline-offset-4">Cómo cotizar una oficina móvil</a></li>
        <li><a href="/blog/requisitos-instalar-oficina-movil-en-obra" class="font-display text-vx-black underline decoration-vx-orange decoration-2 underline-offset-4">Requisitos para instalarla</a></li>
        <li><a href="/blog/como-se-transporta-oficina-movil" class="font-display text-vx-black underline decoration-vx-orange decoration-2 underline-offset-4">Cómo se transporta</a></li>
      </ul>
    </div>
  </section>

  <FaqList faqs={FAQ_RENTA} block="renta" />

  <section class="relative overflow-hidden bg-vx-black py-16 text-white sm:py-20" aria-labelledby="cta-renta">
    <div class="hatch-dark absolute inset-0" aria-hidden="true"></div>
    <div class="wrap relative">
      <h2 id="cta-renta" class="max-w-3xl text-4xl text-white sm:text-5xl">Cuéntanos tu obra y te cotizamos</h2>
      <div class="mt-8 flex flex-wrap gap-3">
        <WaButton block="renta-final" size="lg" />
      </div>
    </div>
  </section>
</BaseLayout>
