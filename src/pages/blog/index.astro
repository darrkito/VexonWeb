---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import WaButton from '../../components/WaButton.astro';
import { SITE } from '../../lib/site';
import { breadcrumbs, itemList } from '../../lib/schema';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const [destacado, ...resto] = posts;
const schema = [
  breadcrumbs([{ name: 'Inicio', url: SITE.url }, { name: 'Blog', url: `${SITE.url}/blog` }]),
  itemList(posts.map((p) => ({ name: p.data.title, url: `${SITE.url}/blog/${p.id}` }))),
];
---
<BaseLayout
  title="Blog: Guías de Oficinas Móviles para Obra en Guadalajara | Vexon"
  description="Guías prácticas para elegir, instalar y rentar oficinas móviles en Guadalajara: tamaños, requisitos, costos y comparativas para obra y remodelación."
  schema={schema}
  pageType="CollectionPage"
  ogImage="/og/blog.jpg"
>
  <section class="bg-vx-sand pb-12 pt-4 sm:pt-6">
    <div class="wrap">
      <Breadcrumbs items={[{ name: 'Inicio', href: '/' }, { name: 'Blog' }]} />
      <h1 class="mt-6 text-[2.4rem] leading-[1.04] sm:text-6xl">Guías para tu obra</h1>
      <p class="lead mt-4">Cómo elegir, instalar y aprovechar una oficina móvil en Guadalajara, explicado por el equipo de Vexon.</p>
    </div>
  </section>
  <section class="section bg-white !pt-12">
    <div class="wrap">
      {destacado && (
        <article class="grid gap-6 rounded-2xl bg-vx-black p-7 text-white sm:p-10 lg:grid-cols-[1.4fr_1fr] lg:items-end">
          <div>
            <p class="text-sm text-white/60">{destacado.data.category} · Actualizado el {fmt(destacado.data.updated ?? destacado.data.date)}</p>
            <h2 class="mt-3 text-3xl text-white sm:text-4xl"><a href={`/blog/${destacado.id}`} class="hover:underline underline-offset-4">{destacado.data.title}</a></h2>
            <p class="mt-3 text-white/75">{destacado.data.description}</p>
          </div>
          <a href={`/blog/${destacado.id}`} class="btn btn-wa justify-self-start lg:justify-self-end">Leer la guía</a>
        </article>
      )}
      <ul class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {resto.map((p) => (
          <li class="card flex flex-col p-6">
            <p class="text-sm text-vx-slate">{p.data.category}</p>
            <h2 class="mt-2 text-xl"><a href={`/blog/${p.id}`} class="hover:underline underline-offset-4">{p.data.title}</a></h2>
            <p class="mt-2 flex-1 text-[0.98rem] text-vx-slate">{p.data.description}</p>
            <p class="mt-4 text-sm text-vx-slate">Actualizado el {fmt(p.data.updated ?? p.data.date)}</p>
          </li>
        ))}
      </ul>
      <div class="mt-14 flex flex-col items-start gap-4 rounded-2xl bg-vx-sand p-7 sm:flex-row sm:items-center sm:justify-between">
        <p class="font-display text-2xl text-vx-black">¿Tienes una pregunta que no está aquí?</p>
        <WaButton block="blog-index" label="Pregúntanos por WhatsApp" />
      </div>
    </div>
  </section>
</BaseLayout>
