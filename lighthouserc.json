{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/preview-cdn.mjs",
      "startServerReadyPattern": "listening",
      "url": [
        "http://127.0.0.1:4322/",
        "http://127.0.0.1:4322/oficinas-moviles",
        "http://127.0.0.1:4322/oficinas-moviles/vx-6m",
        "http://127.0.0.1:4322/soluciones/constructoras",
        "http://127.0.0.1:4322/contacto",
        "http://127.0.0.1:4322/blog/guia-oficinas-moviles-obra-guadalajara"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2000
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}